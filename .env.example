# Application URL
APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"

# Session & Security (generate strong random 32+ character strings for production)
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_SESSION_SECRET"
ADMIN_BOOTSTRAP_SECRET="REPLACE_WITH_ONE_TIME_SUPER_ADMIN_BOOTSTRAP_SECRET"

# Supabase Configuration (for production PostgreSQL, Auth, Storage, and RLS)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Payment Gateways (Server-side secret keys must never be exposed in browser code)
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# Transactional Email Service (e.g., Resend API Key)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS=""

# Development Options
ENABLE_DEV_SEED="true"
